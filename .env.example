# Credenciales de PostgreSQL usadas por Docker Compose.
# Genere una contraseña con: openssl rand -base64 32
POSTGRES_DB=misiva
POSTGRES_USER=misiva
POSTGRES_PASSWORD=cambie-esta-contraseña

# URL pública desde la que se abre Misiva. En producción use HTTPS.
# APP_ORIGIN=https://misiva.ejemplo.com

# Para ejecutar Next.js fuera de Docker, configure directamente:
# DATABASE_URL=postgresql://misiva:contraseña@localhost:5432/misiva
# DATABASE_SSL=0

# Solo es necesario para clientes MCP ejecutados dentro de un navegador en otro origen.
# MISIVA_MCP_ALLOWED_ORIGINS=https://ai.ejemplo.com

# Compatibilidad con instalaciones locales sin PostgreSQL. En instalaciones nuevas,
# cree tokens MCP desde Cuenta y acceso MCP dentro de Misiva.
# MISIVA_MCP_TOKEN=token-local-heredado

# ============================================================================
# 1. Backend en paralelo en Go (Recomendado)
# ============================================================================
# En desarrollo local, levante ambos con `npm run dev:full` (usa SQLite sin Docker)
# o defina GO_BACKEND_URL si corre el servidor Go por separado:
# GO_BACKEND_URL=http://127.0.0.1:8080
# MISIVA_SERVER_PROJECTS=1

# Variables opcionales del servicio Go (/backend):
# GO_HOST=127.0.0.1
# GO_PORT=8080
# DB_DRIVER=sqlite               # "sqlite" (local) o "postgres" (producción/Docker)
# SQLITE_PATH=./storage/misiva.db

# ============================================================================
# 2. PostgreSQL / Docker Compose
# ============================================================================
# Genere una contraseña segura con: openssl rand -base64 32
POSTGRES_DB=misiva
POSTGRES_USER=misiva
POSTGRES_PASSWORD=cambie-esta-contraseña

# URL pública desde la que se abre Misiva. En producción use HTTPS.
# APP_ORIGIN=https://misiva.ejemplo.com

# Conexión PostgreSQL directa (usada por el backend en Go cuando DB_DRIVER=postgres
# o por el modo heredado de Next.js si no se define GO_BACKEND_URL):
# DATABASE_URL=postgresql://misiva:contraseña@localhost:5432/misiva
# DATABASE_SSL=0

# ============================================================================
# 3. Servidor MCP (Model Context Protocol)
# ============================================================================
# Orígenes web adicionales autorizados para clientes MCP en navegador:
# MISIVA_MCP_ALLOWED_ORIGINS=https://ai.ejemplo.com

# Token personal MCP para transporte stdio (`npm run mcp:stdio`) o modo local sin DB:
# MISIVA_MCP_TOKEN=misiva_mcp_...

# Dirección y puerto de escucha del backend en Go
GO_HOST=127.0.0.1
GO_PORT=8080

# Motor de base de datos: "sqlite" (por defecto en local) o "postgres"
DB_DRIVER=sqlite
SQLITE_PATH=../storage/misiva.db

# Si usa PostgreSQL (ej. en producción o Docker Compose), descomente:
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://misiva:contraseña@localhost:5432/misiva

# Origen público del frontend Next.js para CORS y verificación CSRF
APP_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Duración de las sesiones interactivas en días
SESSION_DAYS=30
